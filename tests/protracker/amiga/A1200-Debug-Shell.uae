config_description=A1200 Debug Shell: A1200 (68020 at real speed but not cycle-exact, so serial input keeps up; AGA, 2 MB chip, PAL, KS 3.1), Workbench 3.1 from a folder, Shell on serial TCP 127.0.0.1:1234 for AmiShell
use_gui=no
kickstart_rom_file=C:\Users\Public\Documents\Amiga Files\Shared\rom\amiga-os-310-a1200.rom
chipset=aga
chipset_compatible=A1200
ntsc=false
cpu_model=68020
cpu_speed=real
cpu_compatible=false
cpu_cycle_exact=false
cycle_exact=false
chipmem_size=4
fastmem_size=0
bogomem_size=0
nr_floppies=1
floppy0=
filesystem2=rw,DH0:Workbench:C:\Users\Public\Documents\Amiga Files\Shared\dir\A1200-Debug-WB31,1
filesystem2=rw,DH1:Shared:C:\Users\Public\Documents\Amiga Files\Shared\dir\Local,0
win32.serial_port=TCP://127.0.0.1:1234
serial_translate=crlf_cr
serial_direct=true
